---
layout: feed
---
 <title>{{ site.title }}</title>
 <subtitle>{{ site.tagline }}</subtitle>
 <link href="{{ site.url }}/blog/atom.xml" rel="self" type="application/atom+xml"/>
 <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>http://juleshenry.github.io/blog</id>
 <author>
   <name>{{ site.author }}</name>
 </author>

 {% assign feed_count = 0 %}
 {% for post in site.posts %}
 {% unless post.redirect_to %}
 {% if feed_count < 20 %}
 <entry>
   <title>{{ post.title | remove_first: 'Back-of-the-Envelope:' | strip | xml_escape }}</title>
   <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>http://juleshenry.github.io/{{ post.id }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% assign feed_count = feed_count | plus: 1 %}
 {% endif %}
 {% endunless %}
 {% endfor %}
